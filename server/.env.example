# Docker production: MONGO_URI and PORT are set by docker-compose.yml (the db
# container). Leave MONGO_URI_ATLAS unset there unless production should use
# Atlas instead, since it takes precedence over MONGO_URI.
MONGO_URI=your_mongodb_connection_string_here
MONGO_URI_ATLAS=your_mongodb_atlas_connection_string_here
JWT_SECRET=your_jwt_secret_here
PORT=5000
NODE_ENV=development

# ── Email / Notifications ─────────────────────────────────────────────────────
EMAIL_USER=your_email_user_here
EMAIL_PASS=your_email_pass_here
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
BACKEND_URL=your_backend_url_here
REACT_APP_API_URL=your_react_app_api_url_here

# ── Google Sheets Service Account (Inventive / Contrive forms) ────────────────
CLIENT_EMAIL=your_google_sheets_service_account_email_here
PRIVATE_KEY=your_google_sheets_private_key_here

# ── Cloudinary (Club / Project images) ───────────────────────────────────────
CLOUD_NAME=your_cloud_name_here
CLOUD_API_KEY=your_cloud_api_key_here
CLOUD_API_SECRET=your_cloud_api_secret_here

# ── Firebase Admin SDK (Team Member images → Firebase Storage) ────────────────
# Obtain from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_CLIENT_EMAIL=your_firebase_service_account_email_here
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com




